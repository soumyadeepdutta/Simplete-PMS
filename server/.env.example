# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
MONGODB_URI=mongodb://mongo:27017/simplete
COOKIE_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=simplete_session
SESSION_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_HOURS=720
# Optional: require this token on first-run owner setup
# SETUP_TOKEN=your-secret-setup-token
CORS_ORIGIN=http://localhost:3000
MCP_ALLOWED_HOSTS=localhost:4000,127.0.0.1:4000
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
PUBLIC_BASE_URL=http://localhost:4000
# MCP session idle TTL (minutes). Expired sessions require re-initialize.
MCP_SESSION_TTL_MINUTES=60
# MCP per-token/user sliding-window rate limit. Set MCP_RATE_LIMIT_RPM=0 to disable.
MCP_RATE_LIMIT_RPM=120
MCP_RATE_LIMIT_WINDOW_SECONDS=60
