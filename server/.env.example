# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/simplete
# Or MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/simplete
COOKIE_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=simplete_session
SESSION_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_HOURS=720
# Optional: require this token on first-run owner setup
# SETUP_TOKEN=your-secret-setup-token
CORS_ORIGIN=http://localhost:3000
MCP_ALLOWED_HOSTS=localhost:4000,127.0.0.1:4000
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
PUBLIC_BASE_URL=http://localhost:4000
# MCP session idle TTL (minutes). Expired sessions require re-initialize.
MCP_SESSION_TTL_MINUTES=60
# MCP per-token/user sliding-window rate limit. Set MCP_RATE_LIMIT_RPM=0 to disable.
MCP_RATE_LIMIT_RPM=120
MCP_RATE_LIMIT_WINDOW_SECONDS=60
# Set by the packaged CLI (npx simplete-pms) to serve the built SPA from this
# server instead of relying on the Vite dev proxy. Leave unset for `npm run dev`.
# WEB_ROOT=/absolute/path/to/built/spa
# Override the session cookie's Secure attribute. Unset = derive from whether
# PUBLIC_BASE_URL is https://. Set true if a reverse proxy terminates TLS for you.
# SECURE_COOKIES=true
